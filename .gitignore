# Godot 4+ specific ignores
.godot/
# Android build template is installed fresh by CI via
# `godot --headless --install-android-build-template`. Do NOT commit it.
/android/build/
/export/

# Mono / C# (if added later)
.mono/
data_*/
mono_crash.*.json

# OS / Editor noise
.DS_Store
Thumbs.db
*.swp
*.swo
.vscode/
.idea/
*.iml

# Build artifacts
*.apk
*.aab
debug.keystore
*.keystore.p12

# NOTE: keystore/hieudash.keystore IS committed on purpose.
# It is a stable release-signing keystore (password: hieudash_release_2026)
# so that APKs are signed consistently across CI builds and local builds.
# Without a stable keystore, every CI run signs with a fresh cert and
# Google Play Protect warns "package seems corrupted" on install.
!keystore/hieudash.keystore

# Local config overrides
export_presets.local.cfg
project.godot.local

# Backup files
*.bak
*~

# Logs
*.log

# Android build artifacts (the whole android/ dir is generated by
# `godot --headless --install-android-build-template` — do NOT commit it).
/android/
